{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "nodemon",
    "build": "tsc -p . && node -e \"const fs = require('fs'); fs.cpSync('src/generated','dist/src/generated',{recursive:true,filter:(src,dest)=>!(dest.endsWith('.dll.node')&&fs.existsSync(dest))})\"",
    "start": "node dist/src/server.js",
    "typecheck": "tsc --noEmit -p .",
    "test": "node --import tsx --test tests/productMatcherAndUrlSanitization.test.ts tests/storeRedirection.test.ts tests/priceNormalizer.test.ts tests/priceAnalytics.test.ts tests/stores.test.ts tests/assistant.test.ts tests/matching.test.ts tests/smartprix.test.ts tests/auth.test.ts tests/security.test.ts tests/searchAndCatalog.test.ts tests/storesAndExternal.test.ts tests/alertsAndNotifications.test.ts tests/predictionAndMlIntegration.test.ts tests/emailNotificationPipeline.test.ts tests/marketIntelligence.test.ts tests/authOtpAndTracking.test.ts",
    "seed": "tsx prisma/seed.ts",
    "sync": "tsx scripts/sync.ts",
    "verify:smartprix": "tsx scripts/verifySmartprix.ts",
    "ingest:mobiles": "tsx scripts/ingestMobiles.ts",
    "enrich:mobiles": "tsx scripts/enrichExistingMobiles.ts",
    "db:up": "docker compose -f ../docker-compose.yml up -d postgres",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "postinstall": "prisma generate"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.1.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/ioredis": "^4.28.10",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.2.0",
    "@types/nodemailer": "^8.0.2",
    "nodemon": "^3.1.14",
    "prisma": "^6.19.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
