{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p . && node -e \"require('fs').cpSync('src/generated','dist/src/generated',{recursive:true})\"",
    "start": "node dist/src/server.js",
    "typecheck": "tsc --noEmit -p .",
    "test": "node --import tsx --test tests/priceAnalytics.test.ts tests/stores.test.ts tests/assistant.test.ts tests/matching.test.ts",
    "seed": "tsx prisma/seed.ts",
    "sync": "tsx scripts/sync.ts",
    "db:up": "docker compose -f ../docker-compose.yml up -d postgres",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "postinstall": "prisma generate"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.2.0",
    "prisma": "^6.19.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
