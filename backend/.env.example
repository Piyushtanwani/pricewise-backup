# Copy this file to .env and fill in the values. Never commit .env.

PORT=5000
NODE_ENV=development
# Comma-separated list of allowed browser origins (Vite dev server by default)
CORS_ORIGIN=http://localhost:5173

# docker-compose.yml exposes PostgreSQL on host port 5433
DATABASE_URL="postgresql://postgres:password@localhost:5433/pricewise?schema=public"

# Required. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d
# Required for /api/admin/* (send as the x-admin-key header). Admin routes are disabled when empty.
ADMIN_API_KEY=

# Optional Redis connection for real-time live price comparison cache
REDIS_URL=

# Optional FastAPI ML service (ml-service/). When empty, predictions use the built-in trend model.
ML_SERVICE_URL=

# Background price sync interval in minutes. 0 disables the scheduler (use `npm run sync` instead).
PRICE_SYNC_INTERVAL_MINUTES=0
# Minimum best-price drop (percent) that creates a PRICE_DROP notification for watchers
PRICE_DROP_THRESHOLD_PERCENT=5

# --- Amazon Creators API ---------------------------------------------------
# PA-API 5.0 was retired on 15 May 2026; legacy Access Key / Secret Key pairs no longer work.
# Register at https://affiliate-program.amazon.com/creatorsapi/docs/en-us/onboarding
AMAZON_CREATORS_CLIENT_ID=
AMAZON_CREATORS_CLIENT_SECRET=
# Your Amazon Associates tracking ID, e.g. yourtag-21
AMAZON_PARTNER_TAG=
AMAZON_MARKETPLACE=www.amazon.in
# India uses the EU token endpoint (credential version 3.2)
AMAZON_TOKEN_URL=https://api.amazon.co.uk/auth/o2/token
AMAZON_CREATORS_API_BASE_URL=https://creatorsapi.amazon

# --- Flipkart Affiliate API ------------------------------------------------
# Tracking ID and API token from https://affiliate.flipkart.com (API Token section)
FLIPKART_AFFILIATE_ID=
FLIPKART_AFFILIATE_TOKEN=
FLIPKART_API_BASE_URL=https://affiliate-api.flipkart.net/affiliate/1.0

# --- Parse.bot (Smartprix Scraper) -----------------------------------------
# API key from https://parse.bot (Settings -> API Keys, starts with pmx_)
PARSE_API_KEY=
PARSE_BASE_URL=https://api.parse.bot
PARSE_SMARTPRIX_SCRAPER_ID=37d36dc7-0edf-44d4-8099-976c2da8a33e
PARSE_SNAPSHOT_VERSION=8

# --- Groq Cloud AI ---------------------------------------------------------
# API key from https://console.groq.com (starts with gsk_)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Email Notifications (Nodemailer / Gmail) -------------------------------
# Gmail account and 16-character Google App Password (not your personal password)
GMAIL_USER=
GMAIL_APP_PASS=

# --- SerpApi Google Shopping ------------------------------------------------
# API key from https://serpapi.com
SERPAPI_API_KEY=


